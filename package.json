{
  "name": "math",
  "private": true,
  "type": "module",
  "description": "The math family of pure-TypeScript libraries — zero runtime dependencies, tsc-only builds, no toolchain beyond npm",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:build": "npm run test:build --workspaces --if-present",
    "docs": "npm run docs --workspaces --if-present",
    "examples": "for f in examples/*.mjs; do echo \"== $f\"; node \"$f\" || exit 1; done",
    "example:01": "node examples/01-symbolic-calculus.mjs",
    "example:02": "node examples/02-algebra-over-structures.mjs",
    "example:03": "node examples/03-exact-numbers-and-autodiff.mjs",
    "example:04": "node examples/04-iteration-pipelines.mjs",
    "example:05": "node examples/05-prototype-patch.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math.git"
  },
  "license": "MIT"
}
