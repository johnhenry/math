{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "biome.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "cache": true
    },
    "test:build": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "check": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "format": {
      "cache": false
    },
    "check:fix": {
      "cache": false
    },
    "docs": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "docs/api/**"
      ],
      "cache": true
    }
  }
}
